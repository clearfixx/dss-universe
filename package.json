{
  "name": "dss-universe",
  "version": "0.1.0",
  "private": true,
  "description": "Developer Space Station Universe monorepo",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:full": "node scripts/run-full-tests.mjs",
    "test:api-build-entry": "node --test scripts/api-build-entry.test.mjs scripts/auth-rest-build.test.mjs",
    "test:full-policy": "node --test scripts/full-api-test-policy.test.mjs scripts/turbo-test-environment.test.mjs scripts/full-api-test-processor.integration.test.mjs scripts/full-quality-policy.test.mjs scripts/web-test-concurrency.test.mjs scripts/workspace-coverage-policy.test.mjs scripts/web-smoke-endpoint.test.mjs",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "test:cov": "turbo test:cov",
    "test:dependency-patches": "node --test scripts/braces-patch.test.mjs",
    "security:check": "node scripts/check-dependency-security.mjs",
    "test:security-policy": "node --test scripts/check-dependency-security.test.mjs scripts/dependency-security-versions.test.mjs",
    "db:validate": "pnpm --filter @dss/api db:validate",
    "db:check-drift": "pnpm --filter @dss/api exec prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:generate": "pnpm --filter @dss/api db:generate",
    "architecture:check": "node scripts/check-architecture.mjs && node scripts/check-editor-licenses.mjs && node --test scripts/architecture/analyze-boundaries.test.mjs scripts/architecture/analyze-file-graph.test.mjs && node scripts/architecture/report-boundaries.mjs --check-baseline",
    "architecture:report": "node scripts/architecture/report-boundaries.mjs",
    "architecture:baseline": "node scripts/architecture/report-boundaries.mjs --check-baseline",
    "test:architecture": "node --test scripts/architecture/analyze-boundaries.test.mjs scripts/architecture/analyze-file-graph.test.mjs",
    "graphql:codegen": "pnpm --filter @dss/web graphql:codegen",
    "graphql:check": "pnpm --filter @dss/web graphql:check && git diff --exit-code -- apps/api/src/schema.gql apps/web/src/gql",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:validate && pnpm db:check-drift && pnpm test:full-policy && pnpm test:full && pnpm build && pnpm test:api-build-entry && pnpm architecture:check",
    "quality:full": "node scripts/run-full-quality.mjs",
    "helpers:verify": "node tools/agent-helpers/verify-archive.mjs",
    "storage:coordination:verify": "node tools/agent-helpers/debt037/run-coordination-proof.mjs",
    "test:quality-policy": "node --test scripts/full-quality-policy.test.mjs scripts/mailpit-configuration.test.mjs scripts/web-smoke-endpoint.test.mjs scripts/web-dev-port.test.mjs scripts/bootstrap-environment-policy.test.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "api:db:generate": "pnpm --filter @dss/api db:generate",
    "api:db:migrate": "pnpm --filter @dss/api db:migrate",
    "api:db:deploy": "pnpm --filter @dss/api db:deploy",
    "api:db:push": "pnpm --filter @dss/api db:push",
    "api:db:reset": "pnpm --filter @dss/api db:reset",
    "api:db:seed": "pnpm --filter @dss/api db:seed",
    "api:db:studio": "pnpm --filter @dss/api db:studio",
    "api:dev": "pnpm --filter @dss/api dev",
    "api:build": "pnpm --filter @dss/api build",
    "api:lint": "pnpm --filter @dss/api lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:restart": "docker compose down && docker compose up -d",
    "db:ps": "docker compose ps",
    "db:logs": "docker compose logs -f",
    "db:pgadmin": "start http://localhost:5050",
    "api:prisma:generate": "pnpm --filter @dss/api prisma generate",
    "api:prisma:migrate": "pnpm --filter @dss/api prisma migrate dev",
    "api:prisma:studio": "pnpm --filter @dss/api prisma studio",
    "api:seed": "pnpm --filter @dss/api db:seed"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/pg": "^8.23.1",
    "prettier": "3.8.4",
    "turbo": "2.11.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.23.1"
  }
}
