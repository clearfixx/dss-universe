{
  "name": "dss-universe",
  "version": "0.1.0",
  "private": true,
  "description": "Developer Space Station Universe monorepo",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "test:cov": "turbo test:cov",
    "db:validate": "pnpm --filter @dss/api db:validate",
    "db:generate": "pnpm --filter @dss/api db:generate",
    "architecture:check": "node scripts/check-architecture.mjs && node scripts/check-editor-licenses.mjs",
    "graphql:codegen": "pnpm --filter @dss/web graphql:codegen",
    "graphql:check": "pnpm --filter @dss/web graphql:check && git diff --exit-code -- apps/api/src/schema.gql apps/web/src/gql",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:validate && pnpm test && pnpm build && pnpm architecture:check",
    "clean": "turbo clean && rm -rf node_modules",
    "api:db:generate": "pnpm --filter @dss/api db:generate",
    "api:db:migrate": "pnpm --filter @dss/api db:migrate",
    "api:db:deploy": "pnpm --filter @dss/api db:deploy",
    "api:db:push": "pnpm --filter @dss/api db:push",
    "api:db:reset": "pnpm --filter @dss/api db:reset",
    "api:db:seed": "pnpm --filter @dss/api db:seed",
    "api:db:studio": "pnpm --filter @dss/api db:studio",
    "api:dev": "pnpm --filter @dss/api dev",
    "api:build": "pnpm --filter @dss/api build",
    "api:lint": "pnpm --filter @dss/api lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:restart": "docker compose down && docker compose up -d",
    "db:ps": "docker compose ps",
    "db:logs": "docker compose logs -f",
    "db:pgadmin": "start http://localhost:5050",
    "api:prisma:generate": "pnpm --filter @dss/api prisma generate",
    "api:prisma:migrate": "pnpm --filter @dss/api prisma migrate dev",
    "api:prisma:studio": "pnpm --filter @dss/api prisma studio",
    "api:seed": "pnpm --filter @dss/api db:seed"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/pg": "^8.20.0",
    "prettier": "3.8.4",
    "turbo": "latest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.22.0"
  }
}
