########################################################################################################################
# 🚀 DSS Universe
# ----------------------------------------------------------------------------------------------------------------------
# File        : .env.example
# Module      : Infrastructure
# Purpose     : Development Environment Template
#
# Description :
# This file defines the local development environment used by DSS Universe.
#
# Architecture Notes:
# • Docker, Prisma and the application should always agree on these values.
# • If they don't... they will politely spend the next hour arguing. 🙂
#
# Related:
# • docker-compose.yml
# • apps/api/.env
# • scripts/bootstrap.sh
# • docs/development/environment.md
#
# Engineering Wisdom:
# "The fastest bug is the one prevented by a good environment."
#
# Easter Egg:
# If PostgreSQL suddenly starts listening on port 80...
# congratulations, you've probably invented a new internet. 🌍
#
# 🛰️ DSS Universe Engineering Standards
########################################################################################################################
############################################################
# 🌍 Application
############################################################

NODE_ENV=development

API_PORT=3001
API_GLOBAL_PREFIX=api

############################################################
# 🐘 PostgreSQL
############################################################

POSTGRES_USER=dss_admin
POSTGRES_PASSWORD=dss_password
POSTGRES_DB=dss_universe
POSTGRES_PORT=5433

DATABASE_URL="postgresql://dss_admin:dss_password@localhost:5433/dss_universe?schema=public"

############################################################
# ⚡ Redis
############################################################

REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

############################################################
# 🗄 pgAdmin
############################################################

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@dss.local
PGADMIN_DEFAULT_PASSWORD=admin

############################################################
# 🔐 Authentication
############################################################

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
MEDIA_SIGNING_SECRET=change_me_media_signing_secret_at_least_32_chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Media lifecycle
MEDIA_RETENTION_DAYS=30
MEDIA_CLEANUP_INTERVAL_MS=3600000

############################################################
# 🤖 AI
############################################################

OPENAI_API_KEY=

############################################################
# 📧 Mail
############################################################

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

#
