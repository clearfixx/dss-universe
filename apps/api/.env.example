########################################################################################################################
# 🚀 DSS Universe
# ----------------------------------------------------------------------------------------------------------------------
# File        : apps/api/.env.example
# Module      : API
# Purpose     : API Development Environment Template
#
# Description :
# This file defines API-level environment variables for local development.
# Copy it to "apps/api/.env" before running the API.
#
# Architecture Notes:
# • Root ".env" is used by Docker Compose.
# • This file is used by NestJS, Prisma and API runtime configuration.
# • DATABASE_URL must match root PostgreSQL variables.
# • Never commit real secrets or production credentials.
#
# Related:
# • .env.example
# • docker-compose.yml
# • scripts/bootstrap.sh
# • docs/development/onboarding.md
#
# Engineering Wisdom:
# "Config drift is just a bug wearing a fake mustache." 🥸
#
# 🛰️ DSS Universe Engineering Standards
########################################################################################################################


############################################################
# 🌍 Application
############################################################

NODE_ENV=development
PORT=3001


############################################################
# 🐘 Database
############################################################

DATABASE_URL="postgresql://dss_admin:dss_password@localhost:5433/dss_universe?schema=public"


############################################################
# 🔐 Authentication
############################################################

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_LOGIN_IP_FAILURE_LIMIT=30
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_2FA_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"


############################################################
# ⚡ Redis
############################################################

REDIS_HOST=localhost
REDIS_PORT=6379


############################################################
# 🤖 AI
############################################################

OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_MS=30000


############################################################
# 📧 Mail
############################################################

MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="no-reply@example.com"
PASSWORD_RESET_WEB_URL="http://localhost:3000/reset-password"
EMAIL_VERIFICATION_WEB_URL="http://localhost:3000/verify-email"
