  @@index([createdAt, id], map: "outbox_routing_coordinate_idx")
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([producer, aggregateType, aggregateId, eventName, id], map: "outbox_producer_evidence_idx")
  @@index([correlationId])
  @@map("outbox_events")
}

// DSS File Passport: destination-owned routing persistence; no automatic activation.
enum GamificationActivationState {
  PREPARED
  ACTIVE
  PAUSED
}

enum GamificationPublicationState {
  WAITING
  CLAIMED
  QUEUED
  BLOCKED
}

enum GamificationPublicationFailureCode {
  QUEUE_ADD_FAILED
  CLAIM_EXPIRED
}

model GamificationActivation {
  destination String                      @id @db.VarChar(64)
  state       GamificationActivationState @default(PREPARED)
  cutoff      DateTime?                   @db.Timestamp(3)
  activatedBy String?                     @db.VarChar(200)
  changedBy   String                      @db.VarChar(200)
  revision    BigInt                      @default(0)
  createdAt   DateTime                    @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  updatedAt   DateTime                    @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @updatedAt @db.Timestamp(3)
  discovery   GamificationDiscovery?
  deliveries  GamificationDelivery[]

  @@map("gamification_activations")
}

model GamificationDiscovery {
  destination    String                 @id @db.VarChar(64)
  forwardAt      DateTime?              @db.Timestamp(3)
  forwardId      String?                @db.Uuid
  sweepAt        DateTime?              @db.Timestamp(3)
  sweepId        String?                @db.Uuid
  upperAt        DateTime?              @db.Timestamp(3)
  upperId        String?                @db.Uuid
  epochOpen      Boolean                @default(false)
  epoch          BigInt                 @default(0)
  examined       BigInt                 @default(0)
  epochStartedAt DateTime?              @db.Timestamp(3)
  lastProgressAt DateTime?              @db.Timestamp(3)
  updatedAt      DateTime               @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @updatedAt @db.Timestamp(3)
  activation     GamificationActivation @relation(fields: [destination], references: [destination], onDelete: Restrict, onUpdate: Restrict)

  @@map("gamification_discovery")
}

model GamificationDelivery {
  destination   String                           @db.VarChar(64)
  eventId       String                           @db.Uuid
  state         GamificationPublicationState     @default(WAITING)
  availableAt   DateTime                         @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  claimToken    String?                          @db.Uuid
  claimedAt     DateTime?                        @db.Timestamp(3)
  leaseUntil    DateTime?                        @db.Timestamp(3)
  claimCount    BigInt                           @default(0)
  cycle         Int                              @default(0)
  cycleAttempts Int                              @default(0)
  queuedAt      DateTime?                        @db.Timestamp(3)
  createdAt     DateTime                         @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  updatedAt     DateTime                         @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @updatedAt @db.Timestamp(3)
  activation    GamificationActivation           @relation(fields: [destination], references: [destination], onDelete: Restrict, onUpdate: Restrict)
  source        OutboxEvent                      @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  failures      GamificationPublicationFailure[]
  admission     GamificationAdmission?
  rejections    GamificationAdmissionRejection[]

  @@id([destination, eventId])
  @@index([destination, state, availableAt, eventId], map: "gamification_delivery_due_idx")
  @@index([destination, state, leaseUntil, eventId], map: "gamification_delivery_lease_idx")
  @@map("gamification_deliveries")
}

model GamificationPublicationFailure {
  id           String                             @id @db.Uuid
  destination  String                             @db.VarChar(64)
  eventId      String                             @db.Uuid
  claimToken   String                             @unique @db.Uuid
  cycle        Int
  cycleAttempt Int
  code         GamificationPublicationFailureCode
  failedAt     DateTime                           @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  delivery     GamificationDelivery               @relation(fields: [destination, eventId], references: [destination, eventId], onDelete: Restrict, onUpdate: Restrict)

  @@index([destination, failedAt, id], map: "gamification_publication_failure_time_idx")
  @@map("gamification_publication_failures")
}

/// DSS File Passport: immutable root-owned delivery seal; no automatic consumer activation.
model GamificationAdmission {
  id                String   @id @db.Uuid
  destination       String   @db.VarChar(64)
  eventId           String   @db.Uuid
  cutoff            DateTime @db.Timestamp(3)
  descriptorId      String   @db.VarChar(128)
  descriptorVersion Int
  codecVersion      Int
  projection        Json
  projectionDigest  Bytes
  encodedBytes      Int
  createdAt         DateTime @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)

  delivery GamificationDelivery             @relation(fields: [destination, eventId], references: [destination, eventId], onDelete: Restrict, onUpdate: Restrict)
  receipt  GamificationConsumptionReceipt?
  attempts GamificationConsumptionAttempt[]
  progress GamificationOwnerProgress[]

  @@unique([destination, eventId], map: "gamification_admission_event_key")
  @@unique([id, destination], map: "gamification_admission_destination_key")
  @@map("gamification_admissions")
}

/// DSS File Passport: fenced technical work state; owner effects remain owner-local.
model GamificationConsumptionReceipt {
  admissionId       String    @id @db.Uuid
  destination       String    @db.VarChar(64)
  state             String    @default("READY") @db.VarChar(16)
  epoch             BigInt    @default(0)
  claimSequence     BigInt    @default(0)
  technicalFailures Int       @default(0)
  claimToken        String?   @unique @db.Uuid
  claimedAt         DateTime? @db.Timestamp(3)
  leaseUntil        DateTime? @db.Timestamp(3)
  availableAt       DateTime? @db.Timestamp(3)
  blockCode         String?   @db.VarChar(64)
  pointsDone        Boolean
  levelsDone        Boolean
  achievementsDone  Boolean
  createdAt         DateTime  @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  updatedAt         DateTime  @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @updatedAt @db.Timestamp(3)

  admission GamificationAdmission @relation(fields: [admissionId, destination], references: [id, destination], onDelete: Restrict, onUpdate: Restrict)

  @@unique([admissionId, destination], map: "gamification_receipt_destination_key")
  @@index([destination, state, availableAt, admissionId], map: "gamification_consumption_due_idx")
  @@index([destination, state, leaseUntil, admissionId], map: "gamification_consumption_lease_idx")
  @@map("gamification_consumption_receipts")
}

/// DSS File Passport: one open-to-terminal technical attempt; settled history is immutable.
model GamificationConsumptionAttempt {
  id            String    @id @db.Uuid
  admissionId   String    @db.Uuid
  epoch         BigInt
  claimSequence BigInt
  claimToken    String    @unique @db.Uuid
  state         String    @default("OPEN") @db.VarChar(16)
  code          String?   @db.VarChar(64)
  startedAt     DateTime  @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  finishedAt    DateTime? @db.Timestamp(3)

  admission GamificationAdmission @relation(fields: [admissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([admissionId, epoch, claimSequence], map: "gamification_consumption_attempt_key")
  @@map("gamification_consumption_attempts")
}

/// DSS File Passport: bounded owner-local resume coordinates, persisted with receipt CAS.
model GamificationOwnerProgress {
  admissionId  String   @db.Uuid
  owner        String   @db.VarChar(16)
  codecVersion Int
  coordinates  Json
  updatedAt    DateTime @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @updatedAt @db.Timestamp(3)

  admission GamificationAdmission @relation(fields: [admissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([admissionId, owner])
  @@map("gamification_owner_progress")
}

/// DSS File Passport: append-only projection rejection, distinct from queue publication failure.
model GamificationAdmissionRejection {
  id                String   @id @db.Uuid
  destination       String   @db.VarChar(64)
  eventId           String   @db.Uuid
  claimToken        String   @unique @db.Uuid
  cycle             Int
  cycleAttempt      Int
  descriptorId      String?  @db.VarChar(128)
  descriptorVersion Int?
  code              String   @db.VarChar(64)
  observedAt        DateTime @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)

  delivery GamificationDelivery @relation(fields: [destination, eventId], references: [destination, eventId], onDelete: Restrict, onUpdate: Restrict)

  @@index([destination, observedAt, id], map: "gamification_admission_rejection_time_idx")
  @@index([destination, eventId, cycle, cycleAttempt], map: "gamification_rejection_delivery_idx")
  @@map("gamification_admission_rejections")
}

model ProcessedEvent {
