// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  BANNED
  DELETED
}

enum AccessGroupKind {
  CUSTOM
  PREMIUM
}

enum AccessGroupCapabilityKey {
  KNOWLEDGE_FORGE_GUARDIAN
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum MediaVisibility {
  PUBLIC
  AUTHENTICATED
  PRIVATE
  RESTRICTED
}

enum MediaStorageProvider {
  LOCAL
  MINIO
  S3
}

enum MediaStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
  REJECTED
  QUARANTINED
  DELETING
  DELETED
}

enum MediaUploadStatus {
  INITIATED
  UPLOADING
  COMPLETED
  ABORTED
  EXPIRED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  SERVICE
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum LevelTransitionDirection {
  UP
  DOWN
}

enum AchievementAwardKind {
  RULE
  MANUAL
}

enum NotificationCategory {
  MENTIONS
  DIRECT_MESSAGES
  REPUTATION
  COMMENTS_REPLIES
  SUBSCRIPTIONS
  PUBLISHING_REVIEW
  SUPPORT
}

enum NotificationDigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum ActivityVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum InteractionTargetStatus {
  ACTIVE
  LOCKED
  RETIRED
}

enum ReactionKind {
  LIKE
  UPVOTE
  DOWNVOTE
}

enum ShareChannel {
  FACEBOOK
  X
  THREADS
  INSTAGRAM
  PINTEREST
  COPY_LINK
  PRINT
}

enum ContentReportCategory {
  SPAM
  HARASSMENT
  MISINFORMATION
  ILLEGAL
  OTHER
}

enum ContentReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationAnnotationKind {
  WARNING
  READ_ONLY
  BAN
  REMOVAL
}

enum ModerationSanctionKind {
  WARNING
  READ_ONLY
}

enum ModerationSanctionOrigin {
  MANUAL
  SCOPED
  ESCALATION
}

enum PollVisibility {
  OPEN
  ANONYMOUS
}

enum ForumVisibility {
  PUBLIC
  MEMBERS
  RESTRICTED
}

enum ForumTopicKind {
  DISCUSSION
  QUESTION
}

enum ForumTopicState {
  OPEN
  CLOSED
  ARCHIVED
  TRASHED
}

enum ForumPostState {
  VISIBLE
  HIDDEN
  DELETED
  PURGED
}

enum ForumStaffRole {
  CURATOR
  MODERATOR
  SUPERMODERATOR
  ADMINISTRATOR
}

enum ContentGateOperator {
  ALL
  ANY
}

enum ContentGateRequirementKind {
  ACCOUNT_AGE_DAYS
  COMMENTS
  FORUM_POSTS
  PUBLICATIONS
  REPUTATION
  GROUP
}

enum NewsArticleStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum NewsPostType {
  STANDARD
  TEXT
  GALLERY
  VIDEO
  AUDIO
}

enum NewsVisibility {
  PUBLIC
  MEMBERS
}

enum NewsFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATETIME
  SELECT
  MULTI_SELECT
  URL
  MEDIA
  GALLERY
  FILE
  MEMBER
}

enum NewsEditorialAction {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  SCHEDULE_CANCELLED
  PUBLISHED
}

enum NewsPaginationMode {
  DISABLED
  PAGES
  LOAD_MORE
  BOTH
}

enum NewsInternalLinkType {
  RELATED
  CONTEXTUAL
  SERIES
}

enum NewsPinScope {
  GLOBAL
  CATEGORY
}

enum ResearchPageKind {
  WIKI
  MANUAL
  RESEARCH
  GUIDE
  CASE_STUDY
  NOTE
  REPORT
}

enum ResearchPageState {
  DRAFT
  ACTIVE
  ARCHIVED
  TOMBSTONED
}

enum ResearchRevisionState {
  IN_REVIEW
  CHANGES_REQUESTED
  REJECTED
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum ResearchReviewAction {
  SUBMITTED
  CHANGES_REQUESTED
  REJECTED
  PUBLISHED
  WITHDRAWN
  ROLLED_BACK
  RESTORED
}

enum ResearchProtectionLevel {
  OPEN
  TRUSTED
  GUARDIAN_ONLY
  LOCKED
}

enum ResearchVisibility {
  PUBLIC
  MEMBERS
  GROUPS
}

enum ResearchInternalLinkType {
  RELATED
  CONTEXTUAL
  PREREQUISITE
  SEE_ALSO
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  username            String     @unique
  passwordHash        String
  displayName         String?
  bio                 String?
  location            String?
  website             String?
  technologies        String[]   @default([])
  interests           String[]   @default([])
  avatarUrl           String?
  avatarMediaId       String?    @unique
  coverUrl            String?
  coverMediaId        String?    @unique
  status              UserStatus @default(ACTIVE)
  deactivatedAt       DateTime?
  authVersion         Int        @default(0)
  loginFailedAttempts Int        @default(0)
  loginLockedUntil    DateTime?

  media               Media[]              @relation("MediaOwner")
  avatarMedia         Media?               @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia          Media?               @relation("UserCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  mediaUploadSessions MediaUploadSession[]

  roles                   UserRole[]
  directPermissions       UserPermission[]
  accessMemberships       AccessGroupMembership[]
  sessions                Session[]
  passwordReset           PasswordReset?
  emailVerification       EmailVerification?
  twoFactor               UserTwoFactor?
  socialLinks             UserSocialLink[]
  privacySettings         UserPrivacySettings?
  followers               UserFollow[]                 @relation("UserFollowers")
  following               UserFollow[]                 @relation("UserFollowing")
  blockedUsers            UserBlock[]                  @relation("UserBlocker")
  blockedByUsers          UserBlock[]                  @relation("UserBlocked")
  wallPosts               UserWallPost[]               @relation("ProfileWallOwner")
  authoredWallPosts       UserWallPost[]               @relation("ProfileWallAuthor")
  notificationPreferences UserNotificationPreferences?
  reputationGiven         ReputationEntry[]            @relation("ReputationActor")
  reputationReceived      ReputationEntry[]            @relation("ReputationRecipient")
  communityPointEntries   CommunityPointEntry[]        @relation("CommunityPointRecipient")
  levelTransitions        LevelTransition[]
  commentsAuthored        Comment[]                    @relation("CommentAuthor")
  commentDrafts           CommentDraft[]
  commentRevisions        CommentRevision[]            @relation("CommentRevisionEditor")
  commentsDeleted         Comment[]                    @relation("CommentDeletedBy")
  mentionsAuthored        Mention[]                    @relation("MentionActor")
  mentionsReceived        Mention[]                    @relation("MentionRecipient")
  reactions               Reaction[]
  bookmarks               Bookmark[]
  interactionViews        InteractionView[]
  interactionShares       InteractionShare[]
  titleGrants             UserTitleGrant[]
  selectedTitle           UserTitleSelection?
  achievementAwards       AchievementAward[]
  activityFeedState       ActivityFeedState?
  contentReports          ContentReport[]              @relation("ContentReportReporter")
  contentReportsReviewed  ContentReport[]              @relation("ContentReportReviewer")
  moderationAnnotations   ModerationAnnotation[]       @relation("ModerationAnnotationActor")
  annotationsRevoked      ModerationAnnotation[]       @relation("ModerationAnnotationRevoker")
  sanctionsReceived       ModerationSanction[]         @relation("ModerationSanctionSubject")
  sanctionsIssued         ModerationSanction[]         @relation("ModerationSanctionIssuer")
  sanctionsRevoked        ModerationSanction[]         @relation("ModerationSanctionRevoker")
  sanctionPolicyUpdates   ModerationSanctionPolicy[]
  pollsCreated            Poll[]
  pollBallots             PollBallot[]
  forumModeratorRoles     ForumModeratorAssignment[]   @relation("ForumModerator")
  forumModeratorsAssigned ForumModeratorAssignment[]   @relation("ForumModeratorAssigner")
  forumModeratorsRevoked  ForumModeratorAssignment[]   @relation("ForumModeratorRevoker")
  forumTopics             ForumTopic[]                 @relation("ForumTopicAuthor")
  forumTopicsCurated      ForumTopic[]                 @relation("ForumTopicCurator")
  forumPosts              ForumPost[]                  @relation("ForumPostAuthor")
  forumPostRevisions      ForumPostRevision[]
  forumPostingCooldown    ForumPostingCooldown?
  forumStaffNotes         ForumPostStaffNote[]         @relation("ForumStaffNoteAuthor")
  forumStaffNotesRemoved  ForumPostStaffNote[]         @relation("ForumStaffNoteRemover")
  forumVotes              ForumPostVote[]              @relation("ForumVoter")
  forumVotesReversed      ForumPostVote[]              @relation("ForumVoteReverser")
  forumTopicViews         ForumTopicView[]
  forumTopicReadStates    ForumTopicReadState[]
  contentGates            ContentGate[]
  newsArticles            NewsArticle[]                @relation("NewsAuthor")
  newsRevisions           NewsRevision[]               @relation("NewsRevisionEditor")
  newsEditorialDecisions  NewsEditorialDecision[]
  newsScheduled           NewsArticle[]                @relation("NewsScheduler")
  newsSettingsUpdated     NewsSettings[]               @relation("NewsSettingsUpdater")
  newsLinksCreated        NewsInternalLink[]           @relation("NewsLinkCreator")
  newsPins                NewsPin[]                    @relation("NewsPinActor")
  researchPagesCreated    ResearchPage[]               @relation("ResearchPageCreator")
  researchPagesTombstoned ResearchPage[]               @relation("ResearchPageTombstoneActor")
  researchDrafts          ResearchDraft[]
  researchRevisions       ResearchRevision[]           @relation("ResearchRevisionAuthor")
  researchReviewDecisions ResearchReviewDecision[]     @relation("ResearchReviewActor")

  refreshTokenHash String?
  emailVerifiedAt  DateTime?
  lastSeenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loginLockedUntil], map: "users_loginLockedUntil_idx")
  @@index([status, deactivatedAt], map: "users_status_deactivatedAt_idx")
  @@map("users")
}

model ContentGate {
  id        String              @id @default(uuid())
  ownerId   String
  operator  ContentGateOperator
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  owner        User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  requirements ContentGateRequirement[]

  @@index([ownerId, createdAt])
  @@map("content_gates")
}

model ContentGateRequirement {
  id        String                     @id @default(uuid())
  gateId    String
  kind      ContentGateRequirementKind
  threshold Int?
  groupKey  String?

  gate ContentGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([gateId, kind])
  @@index([gateId])
  @@map("content_gate_requirements")
}

model UserNotificationPreferences {
  userId          String                      @id
  inAppCategories NotificationCategory[]      @default([MENTIONS, DIRECT_MESSAGES, REPUTATION, COMMENTS_REPLIES, SUBSCRIPTIONS, PUBLISHING_REVIEW, SUPPORT])
  emailEnabled    Boolean                     @default(true)
  emailCategories NotificationCategory[]      @default([MENTIONS, DIRECT_MESSAGES, PUBLISHING_REVIEW, SUPPORT])
  digestFrequency NotificationDigestFrequency @default(OFF)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model UserPrivacySettings {
  userId            String            @id
  profileVisibility ProfileVisibility @default(PUBLIC)
  showLocation      Boolean           @default(true)
  showWebsite       Boolean           @default(true)
  showSocialLinks   Boolean           @default(true)
  showLastSeen      Boolean           @default(false)
  showOnlineStatus  Boolean           @default(true)
  allowFollowers    Boolean           @default(true)
  showFollows       Boolean           @default(true)
  allowWallPosts    Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model UserWallPost {
  id                  String    @id @default(uuid())
  profileOwnerId      String
  authorId            String
  body                String?
  imageMediaId        String?
  deletedAt           DateTime?
  deletedById         String?
  deleteReason        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  interactionTargetId String    @unique

  profileOwner      User              @relation("ProfileWallOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  author            User              @relation("ProfileWallAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  interactionTarget InteractionTarget @relation(fields: [interactionTargetId], references: [id], onDelete: Restrict)

  @@index([profileOwnerId, createdAt, id])
  @@index([authorId, createdAt])
  @@index([deletedAt])
  @@map("user_wall_posts")
}

model InteractionTarget {
  id          String                  @id @default(uuid())
  kind        String
  ownerModule String
  ownerType   String
  ownerId     String
  status      InteractionTargetStatus @default(ACTIVE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @default(now()) @updatedAt

  userWallPost          UserWallPost?
  comments              Comment[]              @relation("CommentParentTarget")
  commentReaction       Comment?               @relation("CommentReactionTarget")
  commentDrafts         CommentDraft[]
  reactions             Reaction[]
  reactionAggregate     ReactionAggregate?
  bookmarks             Bookmark[]
  views                 InteractionView[]
  shares                InteractionShare[]
  mentions              Mention[]
  reports               ContentReport[]
  moderationAnnotations ModerationAnnotation[]
  poll                  Poll?
  forumTopic            ForumTopic?
  newsArticle           NewsArticle?
  researchPage          ResearchPage?

  @@unique([ownerType, ownerId])
  @@index([kind, status])
  @@index([ownerModule, status])
  @@map("interaction_targets")
}

model InteractionView {
  id                  String   @id @default(uuid())
  interactionTargetId String
  actorId             String?
  viewerKey           String
  createdAt           DateTime @default(now())
  lastSeenAt          DateTime @updatedAt

  interactionTarget InteractionTarget @relation(fields: [interactionTargetId], references: [id], onDelete: Cascade)
  actor             User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([interactionTargetId, viewerKey])
  @@index([interactionTargetId, createdAt])
  @@index([actorId, createdAt])
  @@map("interaction_views")
}

model InteractionShare {
  id                  String       @id @default(uuid())
  interactionTargetId String
  actorId             String?
  viewerKey           String
  channel             ShareChannel
  createdAt           DateTime     @default(now())

  interactionTarget InteractionTarget @relation(fields: [interactionTargetId], references: [id], onDelete: Cascade)
  actor             User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([interactionTargetId, channel, viewerKey])
  @@index([interactionTargetId, channel])
  @@index([actorId, createdAt])
  @@map("interaction_shares")
}

model NewsArticle {
  id                  String            @id @default(uuid())
  interactionTargetId String            @unique
  authorId            String
  postType            NewsPostType      @default(STANDARD)
  status              NewsArticleStatus @default(DRAFT)
  visibility          NewsVisibility    @default(PUBLIC)
  language            String            @default("uk")
  slug                String
  title               String
  shortText           String
  document            Json              @db.JsonB
  templateData        Json              @default("{}") @db.JsonB
  plainText           String
  searchText          String
  coverMediaId        String?
  currentVersion      Int               @default(1)
  allowComments       Boolean           @default(true)
  allowRating         Boolean           @default(true)
  allowSharing        Boolean           @default(true)
  allowIndexing       Boolean           @default(true)
  showOnHomepage      Boolean           @default(true)
  featured            Boolean           @default(false)
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedVersion     Int?
  scheduledFor        DateTime?
  scheduledById       String?
  publishedAt         DateTime?
  displayPublishedAt  DateTime?
  archivedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  interactionTarget InteractionTarget       @relation(fields: [interactionTargetId], references: [id], onDelete: Restrict)
  author            User                    @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  scheduledBy       User?                   @relation("NewsScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)
  revisions         NewsRevision[]
  categories        NewsArticleCategory[]
  tags              NewsArticleTag[]
  fieldValues       NewsFieldValue[]
  editorialHistory  NewsEditorialDecision[]
  outgoingLinks     NewsInternalLink[]      @relation("NewsOutgoingLinks")
  incomingLinks     NewsInternalLink[]      @relation("NewsIncomingLinks")
  pin               NewsPin?
  searchProjection  NewsSearchProjection?

  @@unique([language, slug])
  @@index([status, publishedAt, id])
  @@index([status, scheduledFor, id])
  @@index([authorId, status, updatedAt])
  @@index([postType, status, publishedAt])
  @@map("news_articles")
}

/// News-owned public text index; viewer decisions are never persisted here.
model NewsSearchProjection {
  articleId         String  @id
  sourceVersion     Int
  projectionVersion Int
  publicSearchText  String
  hasContentGates   Boolean

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([projectionVersion, hasContentGates, articleId], map: "news_search_projection_gate_scan_idx")
  @@map("news_search_projections")
}

model NewsPin {
  id         String       @id @default(uuid())
  articleId  String       @unique
  scope      NewsPinScope
  categoryId String?
  expiresAt  DateTime?
  pinnedById String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  article  NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pinnedBy User          @relation("NewsPinActor", fields: [pinnedById], references: [id], onDelete: Restrict)

  @@index([scope, expiresAt, createdAt])
  @@index([categoryId, expiresAt, createdAt])
  @@map("news_pins")
}

model NewsSettings {
  id                          String             @id
  newsPaginationMode          NewsPaginationMode @default(BOTH)
  newsPaginationThreshold     Int                @default(12)
  newsPageSize                Int                @default(12)
  commentsPaginationMode      NewsPaginationMode @default(BOTH)
  commentsPaginationThreshold Int                @default(20)
  commentsPageSize            Int                @default(20)
  updatedById                 String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  updatedBy User? @relation("NewsSettingsUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("news_settings")
}

model NewsInternalLink {
  id              String               @id @default(uuid())
  sourceArticleId String
  targetArticleId String
  type            NewsInternalLinkType @default(RELATED)
  anchorText      String
  position        Int                  @default(0)
  createdById     String
  createdAt       DateTime             @default(now())

  sourceArticle NewsArticle @relation("NewsOutgoingLinks", fields: [sourceArticleId], references: [id], onDelete: Cascade)
  targetArticle NewsArticle @relation("NewsIncomingLinks", fields: [targetArticleId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("NewsLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([sourceArticleId, targetArticleId, type])
  @@index([sourceArticleId, position, id])
  @@index([targetArticleId, type])
  @@map("news_internal_links")
}

model NewsCategory {
  id               String         @id @default(uuid())
  parentId         String?
  name             String
  slug             String         @unique
  description      String?
  icon             String?
  sortOrder        Int            @default(0)
  isActive         Boolean        @default(true)
  allowedPostTypes NewsPostType[] @default([STANDARD, TEXT, GALLERY, VIDEO, AUDIO])
  allowComments    Boolean        @default(true)
  allowRating      Boolean        @default(true)
  allowIndexing    Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  parent           NewsCategory?         @relation("NewsCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         NewsCategory[]        @relation("NewsCategoryTree")
  articles         NewsArticleCategory[]
  fieldDefinitions NewsFieldDefinition[]
  pins             NewsPin[]

  @@index([parentId, isActive, sortOrder])
  @@map("news_categories")
}

model NewsArticleCategory {
  articleId  String
  categoryId String
  isPrimary  Boolean @default(false)
  position   Int     @default(0)

  article  NewsArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([articleId, categoryId])
  @@index([categoryId, isPrimary, position])
  @@map("news_article_categories")
}

model NewsTag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles NewsArticleTag[]

  @@map("news_tags")
}

model NewsArticleTag {
  articleId String
  tagId     String

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     NewsTag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([articleId, tagId])
  @@index([tagId, articleId])
  @@map("news_article_tags")
}

model NewsFieldDefinition {
  id              String        @id @default(uuid())
  categoryId      String?
  postType        NewsPostType?
  key             String
  label           String
  type            NewsFieldType
  required        Boolean       @default(false)
  showInShort     Boolean       @default(false)
  showInFull      Boolean       @default(true)
  includeInSearch Boolean       @default(false)
  filterable      Boolean       @default(false)
  options         Json?         @db.JsonB
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category NewsCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  values   NewsFieldValue[]

  @@index([categoryId, postType, isActive])
  @@map("news_field_definitions")
}

model NewsFieldValue {
  articleId    String
  definitionId String
  value        Json     @db.JsonB
  updatedAt    DateTime @updatedAt

  article    NewsArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  definition NewsFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@id([articleId, definitionId])
  @@index([definitionId, articleId])
  @@map("news_field_values")
}

model NewsRevision {
  id            String       @id @default(uuid())
  articleId     String
  version       Int
  editorId      String
  postType      NewsPostType
  language      String
  slug          String
  title         String
  shortText     String
  document      Json         @db.JsonB
  templateData  Json         @default("{}") @db.JsonB
  plainText     String
  searchText    String
  coverMediaId  String?
  changeSummary String?
  createdAt     DateTime     @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  editor  User        @relation("NewsRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([articleId, version])
  @@index([editorId, createdAt])
  @@map("news_revisions")
}

model NewsEditorialDecision {
  id              String              @id @default(uuid())
  articleId       String
  revisionVersion Int
  actorId         String
  action          NewsEditorialAction
  reason          String?
  createdAt       DateTime            @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actor   User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt, id])
  @@index([actorId, action, createdAt])
  @@map("news_editorial_decisions")
}

model ResearchPage {
  id                    String                  @id @default(uuid())
  interactionTargetId   String                  @unique
  creatorId             String
  kind                  ResearchPageKind        @default(WIKI)
  state                 ResearchPageState       @default(DRAFT)
  protectionLevel       ResearchProtectionLevel @default(OPEN)
  visibility            ResearchVisibility      @default(PUBLIC)
  language              String                  @default("uk")
  slug                  String
  publicationGeneration Int                     @default(0)
  publishedRevisionId   String?
  primaryCategoryId     String?
  allowComments         Boolean                 @default(true)
  allowRating           Boolean                 @default(true)
  allowIndexing         Boolean                 @default(true)
  featured              Boolean                 @default(false)
  firstPublishedAt      DateTime?
  lastPublishedAt       DateTime?
  archivedAt            DateTime?
  tombstonedAt          DateTime?
  tombstonedById        String?
  tombstoneReason       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  interactionTarget InteractionTarget           @relation(fields: [interactionTargetId], references: [id], onDelete: Restrict)
  creator           User                        @relation("ResearchPageCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  publishedRevision ResearchRevision?           @relation("ResearchPublishedRevision", fields: [publishedRevisionId, id], references: [id, pageId], onDelete: Restrict)
  primaryCategory   ResearchCategory?           @relation("ResearchPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  tombstonedBy      User?                       @relation("ResearchPageTombstoneActor", fields: [tombstonedById], references: [id], onDelete: Restrict)
