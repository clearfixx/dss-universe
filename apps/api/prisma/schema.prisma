// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaStorage {
  LOCAL
  S3
  R2
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  SERVICE
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  displayName  String?
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  status       UserStatus @default(ACTIVE)

  media Media[]

  roles             UserRole[]
  directPermissions UserPermission[]
  sessions          Session[]

  refreshTokenHash String?
  emailVerifiedAt  DateTime?
  lastSeenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Media {
  id               String          @id @default(uuid())
  ownerId          String?
  kind             MediaKind
  visibility       MediaVisibility @default(PUBLIC)
  storage          MediaStorage    @default(LOCAL)
  path             String
  filename         String
  originalFilename String
  mimeType         String
  extension        String
  size             Int
  checksum         String
  width            Int?
  height           Int?
  deletedAt        DateTime?

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([kind])
  @@index([visibility])
  @@index([deletedAt])
  @@map("media")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  label       String
  description String?
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  label       String
  description String?

  roles           UserPermission[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventName     String
  eventVersion  Int
  eventCategory String
  producer      String
  aggregateType String?
  aggregateId   String?
  correlationId String?
  causationId   String?
  actorId       String?
  payload       Json
  metadata      Json?
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  publishedAt   DateTime?
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_events")
}

model ProcessedEvent {
  id            String   @id @default(uuid())
  eventId       String
  consumerName  String
  eventName     String
  eventVersion  Int
  processedAt   DateTime @default(now())

  @@unique([eventId, consumerName])
  @@index([consumerName, processedAt])
  @@map("processed_events")
}

model DeadLetterEvent {
  id           String   @id @default(uuid())
  eventId      String
  sourceJobId  String?
  eventName    String
  eventVersion Int
  consumerName String
  reason       String
  payload      Json
  attempts     Int
  failedAt     DateTime
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([resolvedAt, failedAt])
  @@map("dead_letter_events")
}

model AuditRecord {
  id            String         @id @default(uuid())
  action        String
  actorType     AuditActorType
  actorId       String?
  targetType    String?
  targetId      String?
  result        AuditResult    @default(SUCCESS)
  reason        String?
  correlationId String?
  requestId     String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  occurredAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@index([action, occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId])
  @@map("audit_records")
}
