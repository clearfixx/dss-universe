// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  BANNED
  DELETED
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum MediaVisibility {
  PUBLIC
  AUTHENTICATED
  PRIVATE
  RESTRICTED
}

enum MediaStorageProvider {
  LOCAL
  MINIO
  S3
}

enum MediaStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
  REJECTED
  QUARANTINED
  DELETING
  DELETED
}

enum MediaUploadStatus {
  INITIATED
  UPLOADING
  COMPLETED
  ABORTED
  EXPIRED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  SERVICE
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum NotificationCategory {
  MENTIONS
  DIRECT_MESSAGES
  REPUTATION
  COMMENTS_REPLIES
  SUBSCRIPTIONS
  PUBLISHING_REVIEW
  SUPPORT
}

enum NotificationDigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum ActivityVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  username      String     @unique
  passwordHash  String
  displayName   String?
  bio           String?
  location      String?
  website       String?
  technologies  String[]   @default([])
  interests     String[]   @default([])
  avatarUrl     String?
  avatarMediaId String?    @unique
  coverUrl      String?
  coverMediaId  String?    @unique
  status        UserStatus @default(ACTIVE)
  deactivatedAt DateTime?
  authVersion   Int        @default(0)

  media               Media[]              @relation("MediaOwner")
  avatarMedia         Media?               @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia          Media?               @relation("UserCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  mediaUploadSessions MediaUploadSession[]

  roles                   UserRole[]
  directPermissions       UserPermission[]
  sessions                Session[]
  socialLinks             UserSocialLink[]
  privacySettings         UserPrivacySettings?
  followers               UserFollow[]                 @relation("UserFollowers")
  following               UserFollow[]                 @relation("UserFollowing")
  blockedUsers            UserBlock[]                  @relation("UserBlocker")
  blockedByUsers          UserBlock[]                  @relation("UserBlocked")
  wallPosts               UserWallPost[]               @relation("ProfileWallOwner")
  authoredWallPosts       UserWallPost[]               @relation("ProfileWallAuthor")
  notificationPreferences UserNotificationPreferences?
  reputationGiven         ReputationEntry[]            @relation("ReputationActor")
  reputationReceived      ReputationEntry[]            @relation("ReputationRecipient")

  refreshTokenHash String?
  emailVerifiedAt  DateTime?
  lastSeenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserNotificationPreferences {
  userId          String                      @id
  inAppCategories NotificationCategory[]      @default([MENTIONS, DIRECT_MESSAGES, REPUTATION, COMMENTS_REPLIES, SUBSCRIPTIONS, PUBLISHING_REVIEW, SUPPORT])
  emailEnabled    Boolean                     @default(true)
  emailCategories NotificationCategory[]      @default([MENTIONS, DIRECT_MESSAGES, PUBLISHING_REVIEW, SUPPORT])
  digestFrequency NotificationDigestFrequency @default(OFF)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model UserPrivacySettings {
  userId            String            @id
  profileVisibility ProfileVisibility @default(PUBLIC)
  showLocation      Boolean           @default(true)
  showWebsite       Boolean           @default(true)
  showSocialLinks   Boolean           @default(true)
  showLastSeen      Boolean           @default(false)
  showOnlineStatus  Boolean           @default(true)
  allowFollowers    Boolean           @default(true)
  showFollows       Boolean           @default(true)
  allowWallPosts    Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model UserWallPost {
  id             String    @id @default(uuid())
  profileOwnerId String
  authorId       String
  body           String?
  imageMediaId   String?
  deletedAt      DateTime?
  deletedById    String?
  deleteReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profileOwner User @relation("ProfileWallOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  author       User @relation("ProfileWallAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([profileOwnerId, createdAt, id])
  @@index([authorId, createdAt])
  @@index([deletedAt])
  @@map("user_wall_posts")
}

model UserFollow {
  id          String    @id @default(uuid())
  followerId  String
  followingId String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, deletedAt, createdAt])
  @@index([followingId, deletedAt, createdAt])
  @@map("user_follows")
}

model UserBlock {
  id        String    @id @default(uuid())
  blockerId String
  blockedId String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, deletedAt, createdAt])
  @@index([blockedId, deletedAt])
  @@map("user_blocks")
}

model UserSocialLink {
  id        String    @id @default(uuid())
  userId    String
  platform  String
  label     String?
  url       String
  position  Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId, deletedAt, position])
  @@map("user_social_links")
}

model Media {
  id               String               @id @default(uuid())
  ownerId          String?
  kind             MediaKind
  status           MediaStatus          @default(PENDING)
  visibility       MediaVisibility      @default(PRIVATE)
  storageProvider  MediaStorageProvider @default(LOCAL)
  bucket           String
  storageKey       String
  originalFilename String
  mimeType         String
  extension        String
  size             Int
  checksum         String
  width            Int?
  height           Int?
  durationMs       Int?
  altText          String?
  caption          String?
  metadata         Json?
  failureCode      String?
  failureReason    String?
  readyAt          DateTime?
  deletedAt        DateTime?

  owner      User?            @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  avatarFor  User?            @relation("UserAvatar")
  coverFor   User?            @relation("UserCover")
  variants   MediaVariant[]
  references MediaReference[]
  auditLogs  MediaAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storageProvider, bucket, storageKey])
  @@index([ownerId])
  @@index([kind])
  @@index([status, createdAt])
  @@index([visibility])
  @@index([deletedAt])
  @@map("media")
}

model MediaVariant {
  id              String               @id @default(uuid())
  mediaId         String
  name            String
  storageProvider MediaStorageProvider
  bucket          String
  storageKey      String
  mimeType        String
  extension       String
  size            Int
  checksum        String
  width           Int?
  height          Int?
  metadata        Json?
  createdAt       DateTime             @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, name])
  @@unique([storageProvider, bucket, storageKey])
  @@index([mediaId])
  @@map("media_variants")
}

model MediaReference {
  id         String    @id @default(uuid())
  mediaId    String
  targetType String
  targetId   String
  purpose    String
  createdBy  String?
  createdAt  DateTime  @default(now())
  removedAt  DateTime?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([mediaId, removedAt])
  @@index([targetType, targetId, purpose, removedAt])
  @@map("media_references")
}

model MediaUploadSession {
  id               String               @id @default(uuid())
  ownerId          String?
  policyKey        String
  status           MediaUploadStatus    @default(INITIATED)
  storageProvider  MediaStorageProvider @default(LOCAL)
  bucket           String
  temporaryKey     String
  originalFilename String
  declaredMimeType String
  declaredSize     Int
  checksum         String?
  metadata         Json?
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([storageProvider, bucket, temporaryKey])
  @@index([ownerId, status])
  @@index([status, expiresAt])
  @@map("media_upload_sessions")
}

model MediaAuditLog {
  id            String   @id @default(uuid())
  mediaId       String
  action        String
  actorId       String?
  reason        String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([actorId, createdAt])
  @@index([correlationId])
  @@map("media_audit_logs")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  label       String
  description String?
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  label       String
  description String?

  roles           UserPermission[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventName     String
  eventVersion  Int
  eventCategory String
  producer      String
  aggregateType String?
  aggregateId   String?
  correlationId String?
  causationId   String?
  actorId       String?
  payload       Json
  metadata      Json?
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  publishedAt   DateTime?
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_events")
}

model ProcessedEvent {
  id           String   @id @default(uuid())
  eventId      String
  consumerName String
  eventName    String
  eventVersion Int
  processedAt  DateTime @default(now())

  @@unique([eventId, consumerName])
  @@index([consumerName, processedAt])
  @@map("processed_events")
}

model DeadLetterEvent {
  id           String    @id @default(uuid())
  eventId      String
  sourceJobId  String?
  eventName    String
  eventVersion Int
  consumerName String
  reason       String
  payload      Json
  attempts     Int
  failedAt     DateTime
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventId])
  @@index([resolvedAt, failedAt])
  @@map("dead_letter_events")
}

model AuditRecord {
  id            String         @id @default(uuid())
  action        String
  actorType     AuditActorType
  actorId       String?
  targetType    String?
  targetId      String?
  result        AuditResult    @default(SUCCESS)
  reason        String?
  correlationId String?
  requestId     String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  occurredAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@index([action, occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId])
  @@map("audit_records")
}

model ActivityEntry {
  id            String             @id @default(uuid())
  sourceEventId String             @unique
  actorId       String
  module        String
  action        String
  subjectType   String
  subjectId     String
  visibility    ActivityVisibility @default(MEMBERS)
  metadata      Json?
  occurredAt    DateTime
  retractedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([actorId, retractedAt, occurredAt, id])
  @@index([module, retractedAt, occurredAt])
  @@index([subjectType, subjectId])
  @@map("activity_entries")
}

model ReputationEntry {
  id              String   @id @default(uuid())
  actorId         String
  recipientId     String
  value           Int
  reason          String
  reversesEntryId String?  @unique
  createdAt       DateTime @default(now())

  actor     User @relation("ReputationActor", fields: [actorId], references: [id], onDelete: Restrict)
  recipient User @relation("ReputationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  reverses ReputationEntry? @relation("ReputationReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversal ReputationEntry? @relation("ReputationReversal")

  @@index([recipientId, createdAt, id])
  @@index([actorId, recipientId, createdAt])
  @@index([reversesEntryId])
  @@map("reputation_entries")
}

model ReputationPolicy {
  id                    String   @id @default("default")
  minimumAccountAgeDays Int      @default(7)
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("reputation_policy")
}
