model CustomTitle {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String
  badge       String
  isActive    Boolean  @default(true)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  grants UserTitleGrant[]

  @@index([isActive, name])
  @@map("custom_titles")
}

model UserTitleGrant {
  id           String    @id @default(uuid())
  userId       String
  titleId      String
  grantedById  String
  grantReason  String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  title     CustomTitle         @relation(fields: [titleId], references: [id], onDelete: Restrict)
  selection UserTitleSelection?

  @@index([userId, grantedAt, id])
  @@index([titleId, revokedAt])
  @@map("user_title_grants")
}

model UserTitleSelection {
  userId     String   @id
  grantId    String   @unique
  selectedAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant UserTitleGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@map("user_title_selections")
}

model CustomTitleSettings {
  id                    String   @id
  selectionCooldownDays Int      @default(30)
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  @@map("custom_title_settings")
}

model AchievementDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  slug        String   @unique
  description String?
  color       String
  badge       String
  isActive    Boolean  @default(true)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  rules  AchievementRule[]
  awards AchievementAward[]

  @@index([isActive, name])
  @@map("achievement_definitions")
}

model AchievementRule {
  id                  String   @id @default(uuid())
  achievementId       String
  eventName           String
  recipientPayloadKey String   @default("userId")
  repeatable          Boolean  @default(false)
  cooldownHours       Int      @default(0)
  dailyCap            Int?
  enabled             Boolean  @default(true)
  createdById         String
  updatedById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  awards      AchievementAward[]

  @@unique([achievementId, eventName])
  @@index([eventName, enabled])
  @@map("achievement_rules")
}

model AchievementAward {
  id              String               @id @default(uuid())
  userId          String
  achievementId   String
  ruleId          String?
  kind            AchievementAwardKind
  reason          String
  awardedById     String?
  sourceEventId   String?
  sourceEventName String?
  sourceType      String?
  sourceId        String?
  awardedAt       DateTime             @default(now())

  user          User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  achievement   AchievementDefinition          @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  rule          AchievementRule?               @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  revocation    AchievementAwardRevocation?
  qualification AchievementAwardQualification?

  @@unique([achievementId, sourceEventId])
  @@index([userId, awardedAt, id])
  @@index([sourceType, sourceId])
  // Inventory id collation C is SQL-owned; catalog/query-plan regressions verify it.
  @@index([sourceType, sourceId, kind, id], map: "achievement_source_inventory_idx")
  @@index([sourceEventId, kind, id], map: "achievement_event_inventory_idx")
  @@index([ruleId, userId, awardedAt])
  @@map("achievement_awards")
}

model AchievementAwardRevocation {
  id          String   @id @default(uuid())
  awardId     String   @unique
  revokedById String?
  reason      String
  occurredAt  DateTime @default(now())

  award AchievementAward @relation(fields: [awardId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@map("achievement_award_revocations")
}

/// Achievements-owned, inactive qualification progress; never a producer journal.
model AchievementSourceCursor {
  id                      String   @id @default(uuid())
  producer                String
  sourceKind              String
  sourceId                String
  appliedRevision         BigInt   @default(0)
  targetRevision          BigInt   @default(0)
  retiredThrough          BigInt   @default(0)
  pendingRetiredThrough   BigInt   @default(0)
  phase                   String   @default("RETIRING")
  enrollmentState         String   @default("PENDING")
  generation              BigInt   @default(0)
  progress                BigInt   @default(0)
  inventoryAfterId        String?
  retirementAfterRevision BigInt?
  retirementAfterAwardId  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  facts AchievementSourceFact[]

  @@unique([producer, sourceKind, sourceId], map: "achievement_source_scope_key")
  @@unique([id, producer], map: "achievement_source_cursor_producer_key")
  @@index([sourceKind, sourceId, producer], map: "achievement_source_compatibility_idx")
  @@map("achievement_source_cursors")
}

/// Immutable verified owner input. Canonical event IDs can carry several facets.
model AchievementSourceFact {
  id                          String   @id @default(uuid())
  cursorId                    String
  producer                    String
  producerFactId              String
  canonicalEventId            String
  revision                    BigInt
  action                      String
  qualificationId             String
  qualificationRevision       BigInt
  qualificationEventId        String
  qualificationFactId         String
  retiredThroughRevision      BigInt
  predecessorWithdrawalFactId String?
  codecVersion                Int      @default(1)
  factDigest                  String
  eventProjection             Json?
  eventProjectionDigest       String?
  createdAt                   DateTime @default(now())

  cursor AchievementSourceCursor         @relation(fields: [cursorId, producer], references: [id, producer], onDelete: Restrict, onUpdate: Restrict)
  awards AchievementAwardQualification[]

  @@unique([cursorId, revision], map: "achievement_source_revision_key")
  @@unique([producer, producerFactId], map: "achievement_source_producer_fact_key")
  @@unique([cursorId, id, revision], map: "achievement_source_fact_binding_key")
  @@index([producer, canonicalEventId, id], map: "achievement_source_event_idx")
  @@index([producer, qualificationEventId], map: "achievement_source_qualification_event_idx")
  @@map("achievement_source_facts")
}

/// Immutable award provenance. Retirement progress belongs to the cursor.
model AchievementAwardQualification {
  awardId               String   @id
  cursorId              String
  factId                String
  qualificationRevision BigInt
  sourceEventId         String
  mappingEvidenceId     String?
  mappingEvidenceDigest String?
  createdAt             DateTime @default(now())

  award AchievementAward      @relation(fields: [awardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fact  AchievementSourceFact @relation(fields: [cursorId, factId, qualificationRevision], references: [cursorId, id, revision], onDelete: Restrict, onUpdate: Restrict)

  @@index([cursorId, qualificationRevision, awardId], map: "achievement_qualification_retirement_idx")
  @@map("achievement_award_qualifications")
}

model ForumCategory {
  id          String          @id @default(uuid())
  slug        String          @unique
  title       String
  description String?
  position    Int             @default(0)
  visibility  ForumVisibility @default(PUBLIC)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  audience   ForumCategoryAudience[]
  forums     Forum[]
  moderators ForumModeratorAssignment[]

  @@index([active, position, id])
  @@map("forum_categories")
}

model ForumCategoryAudience {
  categoryId String
  subjectKey String

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, subjectKey])
  @@index([subjectKey, categoryId])
  @@map("forum_category_audience")
}

model Forum {
  id                 String   @id @default(uuid())
  categoryId         String
  parentId           String?
  slug               String
  title              String
  description        String?
  position           Int      @default(0)
  active             Boolean  @default(true)
  allowsGatedContent Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topics    ForumTopic[]
  tags      ForumTag[]
  category  ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parent    Forum?        @relation("ForumSubforums", fields: [parentId], references: [id], onDelete: Restrict)
  subforums Forum[]       @relation("ForumSubforums")

  @@unique([categoryId, slug])
  @@index([categoryId, parentId, position, id])
  @@map("forums")
}

model ForumModeratorAssignment {
  id           String    @id @default(uuid())
  categoryId   String
  moderatorId  String
  assignedById String
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  moderator  User          @relation("ForumModerator", fields: [moderatorId], references: [id], onDelete: Restrict)
  assignedBy User          @relation("ForumModeratorAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedBy  User?         @relation("ForumModeratorRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([moderatorId, revokedAt])
  @@index([categoryId, revokedAt])
  @@map("forum_moderator_assignments")
}

model ForumTopic {
  id                   String           @id @default(uuid())
  forumId              String
  interactionTargetId  String           @unique
  authorId             String
  kind                 ForumTopicKind   @default(DISCUSSION)
  title                String
  state                ForumTopicState  @default(OPEN)
  stateBeforeTrash     ForumTopicState?
  pinned               Boolean          @default(false)
  curatorId            String?
  acceptedAnswerPostId String?          @unique
  acceptedAt           DateTime?
  acceptedById         String?
  postCount            Int              @default(1)
  ratingUp             Int              @default(0)
  ratingDown           Int              @default(0)
  viewCount            Int              @default(0)
  lastPostNumber       Int              @default(1)
  lastPostAt           DateTime         @default(now())
  lastPostAuthorId     String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  forum             Forum                 @relation(fields: [forumId], references: [id], onDelete: Restrict)
  interactionTarget InteractionTarget     @relation(fields: [interactionTargetId], references: [id], onDelete: Restrict)
  author            User                  @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  curator           User?                 @relation("ForumTopicCurator", fields: [curatorId], references: [id], onDelete: Restrict)
  posts             ForumPost[]
  views             ForumTopicView[]
  readStates        ForumTopicReadState[]
  tags              ForumTopicTag[]
  acceptedAnswer    ForumPost?            @relation("ForumAcceptedAnswer", fields: [acceptedAnswerPostId], references: [id], onDelete: Restrict)

  @@index([forumId, pinned, lastPostAt, id])
  @@index([forumId, pinned, createdAt, id])
  @@index([authorId, createdAt])
  @@map("forum_topics")
}

model ForumPost {
  id               String         @id @default(uuid())
  topicId          String
  number           Int
  authorId         String
  state            ForumPostState @default(VISIBLE)
  document         Json
  plainText        String
  searchText       String
  replyToNumber    Int?
  quotedNumbers    Int[]          @default([])
  ratingUp         Int            @default(0)
  ratingDown       Int            @default(0)
  revision         Int            @default(1)
  createdAt        DateTime       @default(now())
  editedAt         DateTime?
  lastEditorId     String?
  moderatedAt      DateTime?
  moderatedById    String?
  moderationReason String?
  purgedAt         DateTime?
  purgedById       String?
  purgeReason      String?

  topic       ForumTopic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  author      User                 @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions   ForumPostRevision[]
  staffNotes  ForumPostStaffNote[]
  votes       ForumPostVote[]
  acceptedFor ForumTopic?          @relation("ForumAcceptedAnswer")

  @@unique([topicId, number])
  @@index([authorId, createdAt])
  @@map("forum_posts")
}

model ForumPostRevision {
  id        String   @id @default(uuid())
  postId    String
  revision  Int
  document  Json
  plainText String
  editorId  String
  createdAt DateTime @default(now())

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  editor User      @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([postId, revision])
  @@map("forum_post_revisions")
}

model ForumPostingCooldown {
  userId     String   @id
  lastPostAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("forum_posting_cooldowns")
}

model ForumPostStaffNote {
  id          String         @id @default(uuid())
  postId      String
  authorId    String
  role        ForumStaffRole
  body        String
  createdAt   DateTime       @default(now())
  removedAt   DateTime?
  removedById String?

  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  author    User      @relation("ForumStaffNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  removedBy User?     @relation("ForumStaffNoteRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([postId, createdAt, id])
  @@map("forum_post_staff_notes")
}

model ForumPostVote {
  postId         String
  voterId        String
  value          Int
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  voter      User      @relation("ForumVoter", fields: [voterId], references: [id], onDelete: Restrict)
  reversedBy User?     @relation("ForumVoteReverser", fields: [reversedById], references: [id], onDelete: Restrict)

  @@id([postId, voterId])
  @@index([postId, createdAt])
  @@map("forum_post_votes")
}

model ForumRankingSettings {
  id                String   @id @default("default")
  hotGravitySeconds Int      @default(45000)
  hotReplyWeight    Int      @default(0)
  updatedById       String?
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("forum_ranking_settings")
}

model ForumTopicView {
  topicId       String
  userId        String
  firstViewedAt DateTime @default(now())

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([topicId, userId])
  @@map("forum_topic_views")
}

model ForumTopicReadState {
  userId         String
  topicId        String
  lastReadNumber Int
  updatedAt      DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([userId, topicId])
  @@map("forum_topic_read_states")
}

model ForumTag {
  id        String   @id @default(uuid())
  forumId   String
  slug      String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  forum  Forum           @relation(fields: [forumId], references: [id], onDelete: Restrict)
  topics ForumTopicTag[]

  @@unique([forumId, slug])
  @@map("forum_tags")
}

model ForumTopicTag {
  topicId String
  tagId   String

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  tag   ForumTag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([topicId, tagId])
  @@index([tagId, topicId])
  @@map("forum_topic_tags")
}
