diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..6dacf92f524b8b4ab0d4510188ca7dffc4a2a33b
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,44 @@
+/**
+ * ===============================================================
+ * 🚀 DSS Universe
+ * ---------------------------------------------------------------
+ * 📦 Module: Dependency Security
+ * 📄 File: patches/braces@3.0.3.patch (lib/validate-depth.js)
+ *
+ * 🎯 Purpose:
+ * Bounds upstream AST traversal before recursive brace processing.
+ *
+ * 🧠 Responsibilities:
+ * • validates child-node depth without recursion;
+ * • rejects excessively deep and cyclic child graphs.
+ *
+ * 🏗️ Architecture:
+ * Local third-party security patch; no application dependency.
+ *
+ * ⚠️ Important:
+ * Parent links are intentionally not traversed; parsed ASTs contain them.
+ *
+ * 🚀 Build. Share. Grow.
+ * ===============================================================
+ */
+'use strict';
+
+const MAX_DEPTH = 128;
+
+const assertMaxDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop();
+    if (depth > MAX_DEPTH) {
+      throw new RangeError('braces AST exceeds maximum depth of 128');
+    }
+    if (node && node.nodes) {
+      for (const child of node.nodes) {
+        stack.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
+
+exports.MAX_DEPTH = MAX_DEPTH;
+exports.assertMaxDepth = assertMaxDepth;
