{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@dss/api#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/full-api-test-policy.cjs"
      ],
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_HOST",
        "REDIS_PORT",
        "TEST_REDIS_PORT",
        "RUN_IAM_DB_TESTS",
        "RUN_AUTH_DB_TESTS",
        "RUN_RECOVERY_DB_TESTS",
        "RUN_AUTH_REDIS_TESTS",
        "DSS_REQUIRE_FULL_API_TESTS"
      ]
    },
    "@dss/api#test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/full-api-test-policy.cjs"
      ],
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_HOST",
        "REDIS_PORT",
        "TEST_REDIS_PORT",
        "RUN_IAM_DB_TESTS",
        "RUN_AUTH_DB_TESTS",
        "RUN_RECOVERY_DB_TESTS",
        "RUN_AUTH_REDIS_TESTS",
        "DSS_REQUIRE_FULL_API_TESTS"
      ]
    },
    "@dss/api#test:cov": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/full-api-test-policy.cjs"
      ],
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_HOST",
        "REDIS_PORT",
        "TEST_REDIS_PORT",
        "RUN_IAM_DB_TESTS",
        "RUN_AUTH_DB_TESTS",
        "RUN_RECOVERY_DB_TESTS",
        "RUN_AUTH_REDIS_TESTS",
        "DSS_REQUIRE_FULL_API_TESTS"
      ]
    },
    "@dss/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/web-smoke-endpoint.mjs"
      ]
    },
    "@dss/web#lint": {
      "dependsOn": ["^build", "^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/web-smoke-endpoint.mjs"
      ]
    },
    "@dss/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/web-smoke-endpoint.mjs"
      ]
    },
    "@dss/web#test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["DSS_WEB_TEST_PORT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/web-smoke-endpoint.mjs"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
