  },
  "devDependencies": {
    "@dss/eslint-config": "workspace:*",
    "@dss/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
