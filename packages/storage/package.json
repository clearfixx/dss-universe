{
  "name": "@dss/storage",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "native:build": "node native-probe/build.mjs",
    "native:test": "node --test native-probe/probe.test.cjs",
    "native:verify": "pnpm native:build && pnpm native:test",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --maxWorkers=2",
    "test:cov": "vitest run --coverage --maxWorkers=2"
  },
  "devDependencies": {
    "@dss/eslint-config": "workspace:*",
    "@dss/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "node-gyp": "13.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
